<h1>施設一覧（自分の登録分）</h1>

<%= link_to "施設を登録する", new_room_path %>

<table>
  <thead>
    <tr>
      <th>画像</th>
      <th>施設名</th>
      <th>紹介文</th>
      <th>宿泊料金</th>
      <th>作成日</th>
    </tr>
  </thead>
  <tbody>
    <% @rooms.each do |room| %>
      <tr>
        <td>
          <% if room.image.attached? %>
            <%= image_tag room.image, size: "80x80" %>
          <% else %>
            <%= image_tag "default_room.png", size: "80x80" %>
          <% end %>
        </td>
        <td><%= link_to room.name, room_path(room) %></td>
        <td><%= room.description %></td>
        <td><%= number_to_currency(room.price, unit: "¥", precision: 0) %></td>
        <td><%= room.created_at.strftime("%Y/%m/%d") %></td>
      </tr>
    <% end %>
  </tbody>
</table>