<h1>施設登録</h1>

<%= form_with model: @room, local: true do |f| %>
  <% if @room.errors.any? %>
    <div>
      <h2><%= pluralize(@room.errors.count, "件") %>のエラーが発生しました。</h2>
      <ul>
        <% @room.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "施設名" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :description, "詳細" %>
    <%= f.text_area :description %>
  </div>

  <div>
    <%= f.label :price, "宿泊料金（円）" %>
    <%= f.number_field :price, min: 1 %>
  </div>

  <div>
    <%= f.label :address, "住所" %>
    <%= f.text_field :address %>
  </div>

  <div>
    <%= f.label :image, "施設画像" %>
    <%= f.file_field :image %>
  </div>

  <div>
    <%= f.submit "登録する" %>
  </div>
<% end %>

<%= link_to "戻る", rooms_path %>