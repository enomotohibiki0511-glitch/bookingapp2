<h1>施設検索</h1>

<%= form_with url: search_rooms_path, method: :get, local: true do |f| %>
  <div>
    <%= f.label :area, "エリア" %>
    <%= f.select :area, ["東京", "大阪", "京都", "札幌"], { include_blank: "指定しない" }, { selected: params[:area] } %>
  </div>

  <div>
    <%= f.label :keyword, "フリーワード" %>
    <%= f.text_field :keyword, value: params[:keyword] %>
  </div>

  <div>
    <%= f.submit "検索する" %>
  </div>
<% end %>

<p>検索結果：<%= @rooms_count %>件</p>

<table>
  <thead>
    <tr>
      <th>画像</th>
      <th>施設名</th>
      <th>紹介文</th>
      <th>宿泊料金</th>
      <th>住所</th>
    </tr>
  </thead>
  <tbody>
    <% @rooms.each do |room| %>
      <tr>
        <td>
          <% if room.image.attached? %>
            <%= image_tag room.image, size: "80x80" %>
          <% else %>
            <%= image_tag "default_room.png", size: "80x80" %>
          <% end %>
        </td>
        <td><%= link_to room.name, room_path(room) %></td>
        <td><%= room.description %></td>
        <td><%= number_to_currency(room.price, unit: "¥", precision: 0) %></td>
        <td><%= room.address %></td>
      </tr>
    <% end %>
  </tbody>
</table>