<h1>施設詳細</h1>

<% if @room.image.attached? %>
  <%= image_tag @room.image, class: "room-detail-image" %>
<% else %>
  <%= image_tag "default_room.png", class: "room-detail-image" %>
<% end %>

<table>
  <tr>
    <th>施設名</th>
    <td><%= @room.name %></td>
  </tr>
  <tr>
    <th>紹介文</th>
    <td><%= @room.description %></td>
  </tr>
  <tr>
    <th>宿泊料金</th>
    <td><%= number_to_currency(@room.price, unit: "¥", precision: 0) %></td>
  </tr>
</table>

<% if user_signed_in? %>
  <%= link_to "この施設を予約する", new_reservation_path(room_id: @room.id) %>
<% end %>

<%= link_to "戻る", request.referer || root_path %>